# Caddy — ออกใบรับรอง HTTPS ให้อัตโนมัติ
# {$POS_DOMAIN} / {$POS_DL_HASH} ถูกแทนที่ตอนติดตั้ง (deploy/app-lock.sh) — บล็อก DOWNLOAD ถูกตัดออกถ้ายังไม่ตั้งรหัสดาวน์โหลด
# ทุกร้าน (ร้านหลัก + ร้านทดลอง) อยู่หลังประตูเดียวของเซิร์ฟเวอร์ license พอร์ต 3100 — แยกร้านด้วย header X-POS-Shop
{$POS_DOMAIN} {
	encode gzip

	route {
		# DOWNLOAD-BEGIN — หน้าดาวน์โหลดตัวติดตั้งสำหรับร้าน (ต้องใส่รหัสผ่าน)
		handle_path /download/* {
			basic_auth {
				shop {$POS_DL_HASH}
			}
			root * /var/www/pos-download
			file_server
		}
		# DOWNLOAD-END

		# ไฟล์อัปเดตแอปเดสก์ท็อป (electron-updater: latest.yml + Setup.exe)
		handle_path /updates/* {
			root * /var/www/pos-updates
			@nocache path *.yml *.json
			header @nocache Cache-Control "no-cache"
			file_server
		}

		handle {
			reverse_proxy 127.0.0.1:3100
		}
	}
}
