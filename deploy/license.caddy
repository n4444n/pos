# แผงควบคุม license (โดเมนแยกจากร้าน) — ติดตั้งโดย deploy/license-setup.sh → /etc/caddy/conf.d/license.caddy
# โดเมนนี้มีเฉพาะแผงควบคุม · ร้านทั้งหมดอยู่ที่โดเมนของแอป (เช่น https://pos.sh0p.tech)
{$LICENSE_DOMAIN} {
	encode gzip

	# ไฟล์อัปเดตแอป (ให้แอปรุ่นเก่าที่ตั้งค่าไว้ที่โดเมนนี้อัปเดตมาเป็นตัวเดียวกันได้)
	handle_path /updates/* {
		root * /var/www/pos-updates
		@nocache path *.yml *.json
		header @nocache Cache-Control "no-cache"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3100
	}
}
